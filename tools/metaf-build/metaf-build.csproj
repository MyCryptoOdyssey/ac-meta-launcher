<Project Sdk="Microsoft.NET.Sdk">
  <!-- Builds the upstream metaf converter (JJEII/metaf, GPL-3.0) on the .NET 8 SDK.
       Upstream source is cloned to ../vendor/metaf-src by tools/get-metaf.ps1; nothing upstream is modified. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>metaf</RootNamespace>
    <AssemblyName>metaf</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../vendor/metaf-src/project/**/*.cs" Exclude="../vendor/metaf-src/project/obj/**;../vendor/metaf-src/project/bin/**" />
  </ItemGroup>
</Project>
